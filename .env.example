# Optional API Keys for enhanced functionality
# Most features work without these keys using free sources

# News API (newsapi.org) - Free tier: 1000 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# Reddit API (reddit.com/prefs/apps) - Free
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockScanner/1.0

# Alpha Vantage (alphavantage.co) - Free tier: 25 requests/day
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Financial Modeling Prep (Optional) - Free tier: 250 requests/day  
FMP_API_KEY=your_fmp_key